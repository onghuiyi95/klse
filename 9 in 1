        } else if (type === 'macd') {
            const ema12 = ema(closes, 12), ema26 = ema(closes, 26), macdLine = []; 
            for(let i=0; i<closes.length; i++) macdLine.push(ema12[i] - ema26[i]);
            const signalLine = ema(macdLine, 9);
            let macdData = [], signalData = [], histData = [];
            for(let i=0; i<closes.length; i++) {
                let t = globalKlines[i].time, hist = macdLine[i] - signalLine[i];
                macdData.push({ time: t, value: macdLine[i] }); signalData.push({ time: t, value: signalLine[i] });
                histData.push({ time: t, value: hist, color: hist >= 0 ? 'rgba(38, 166, 154, 0.8)' : 'rgba(239, 83, 80, 0.8)' });
            }
            subChartObj.addHistogramSeries({ base: 0 }).setData(histData);
            subChartObj.addLineSeries({ color: '#2962FF', lineWidth: 2 }).setData(macdData);
            subChartObj.addLineSeries({ color: '#FF6D00', lineWidth: 2 }).setData(signalData);
        }

        if (mainCandleSeries) mainCandleSeries.setMarkers(markers);
        subChartObj.timeScale().fitContent();
    }

    async function generateMarketReview() {
        const m = document.getElementById('reviewModal'); m.classList.remove('hidden');
        const c = document.getElementById('reviewContent'); c.innerHTML = '<div class="py-20 text-center"><i class="fa-solid fa-brain fa-fade text-5xl text-indigo-500"></i></div>';
        
        let up=0, down=0, total=currentData.length;
        currentData.forEach(s => { if(parseFloat(s.change)>0) up++; else if(parseFloat(s.change)<0) down++; });
        
        const now = new Date();
        const dateStr = now.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
        const timeStr = now.toLocaleTimeString('zh-CN', { hour12: false, hour: '2-digit', minute: '2-digit' });
        
        const prompt = `时间：${dateStr} ${timeStr}。根据最新收盘数据，大盘上涨 ${up}，下跌 ${down}，总活跃股 ${total}。撰写一份资深分析报告，包含市场情绪与策略。使用 Tailwind HTML 格式。注意：只输出纯 HTML 代码。`;
        
        try {
            // 修复点4：同样修改这里的模型版本
            const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, { 
                method: "POST", headers: { "Content-Type": "application/json" }, 
                body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] }) 
            });
            const json = await res.json();

            // 修复点5：捕获错误
            if (json.error) {
                throw new Error(json.error.message);
            }

            let rawText = json.candidates?.[0]?.content?.parts?.[0]?.text || "无数据";
            const codeBlockRegex = new RegExp('\\x60\\x60\\x60(?:html)?\\s*([\\s\\S]*?)\\s*\\x60\\x60\\x60');
            let htmlMatch = rawText.match(codeBlockRegex);
            let aiHtml = htmlMatch ? htmlMatch[1] : rawText.replace(/\x60\x60\x60html/gi, '').replace(/\x60\x60\x60/g, '').trim();
            
            c.innerHTML = `<div class="mb-4 p-4 rounded border border-slate-700 grid grid-cols-3 text-center" style="background:#0f172a;"><div><div class="text-xs text-slate-500">上涨</div><div class="font-bold text-up">${up}</div></div><div><div class="text-xs text-slate-500">下跌</div><div class="font-bold text-down">${down}</div></div><div><div class="text-xs text-slate-500">广度</div><div class="font-bold text-primary">${total ? ((up/total)*100).toFixed(1) : 0}%</div></div></div>${aiHtml}`;
        } catch (e) { 
            // 修复点6：将报错展示出来
            console.error("Gemini API 复盘请求失败:", e);
            c.innerHTML = `<p class="text-down text-center py-10">AI 云端核心暂时离线。报错信息: ${e.message}</p>`; 
        }
    }

    function switchIndicator() { drawIndicator(document.getElementById('indicatorSelect').value); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
</script>
