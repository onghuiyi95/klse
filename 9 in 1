    function triggerFetch() {
        const code = $('#searchInput').val().trim();
        let targetUrl = `https://hcm.rzfwq.com/hwhcnewB/l_yzg1.zg?device=5&market=my&language=cn`;
        if (code) { targetUrl = `https://hcm.rzfwq.com/hwhcnewB/l_yzg1.zg?code=${code}&device=5&market=my&language=cn`; }
        const displayCode = code || '默认行情';

        $('#loadingMask').css('display', 'flex');
        $('#loadingText').text(`正在拉取 ${displayCode} 的网页源码...`);

        fetch(PROXY_URL + encodeURIComponent(targetUrl))
            .then(res => res.text())
            .then(htmlStr => {
                $('#loadingText').text('解析并提取核心数据...');
                if (htmlStr.trim().startsWith('{')) { try { const jsonObj = JSON.parse(htmlStr); if (jsonObj.contents) htmlStr = jsonObj.contents; } catch(e) {} }
                const parser = new DOMParser(); const doc = parser.parseFromString(htmlStr, 'text/html');

                $('#techText').html(doc.querySelector('.zjyna')?.innerHTML || "无分析数据");
                $('#techDesc1').html(doc.querySelectorAll('.fonta2')[0]?.innerHTML || "");
                $('#techDesc2').html(doc.querySelectorAll('.fonta2')[1]?.innerHTML || "");
                $('#chouma').html(doc.getElementById('chouma')?.innerHTML || "");
                
                const flowSpan = doc.querySelector('.sus_leadzhengu span');
                if (flowSpan) $('#fundFlowDir').text(flowSpan.innerText);
                const zjynaEls = doc.querySelectorAll('.zjyna');
                if (zjynaEls.length > 1) $('#fundText').html(zjynaEls[1].innerHTML);
                
                const sourceBoxes = doc.querySelectorAll('.zjlx_box');
                const targetBoxes = document.querySelectorAll('#fundCardsContainer .zjlx_box');
                sourceBoxes.forEach((box, idx) => { if (targetBoxes[idx]) targetBoxes[idx].innerHTML = box.innerHTML; });

                let ylNum = NaN, zcNum = NaN;
                const textContentAll = doc.body ? doc.body.textContent : htmlStr;
                const pMatch = textContentAll.match(/压力位(?:为|是)?\s*[:：]?\s*(\d+(?:\.\d+)?)/);
                const sMatch = textContentAll.match(/支撑位(?:为|是)?\s*[:：]?\s*(\d+(?:\.\d+)?)/);
                if (pMatch) ylNum = parseFloat(pMatch[1]); if (sMatch) zcNum = parseFloat(sMatch[1]);

                let valuationNum = 20; 
                const vMatches = htmlStr.match(/DrawDPZZZZ\(['"](\d+(?:\.\d+)?)['"]\)/g);
                if (vMatches && vMatches.length > 0) {
                    const lastMatch = vMatches[vMatches.length - 1].match(/\d+(?:\.\d+)?/);
                    if (lastMatch) valuationNum = parseFloat(lastMatch[0]);
                }

                let dataStr = '', dataDayStr = '';
                doc.querySelectorAll('script').forEach(s => {
                    const txt = s.textContent;
                    let dIdx = txt.indexOf("var data = '");
                    if (dIdx !== -1) { let start = dIdx + 12; let end = txt.indexOf("';", start); if (end > start) dataStr = txt.substring(start, end); }
                    let dayIdx = txt.indexOf("var dataDay = '");
                    if (dayIdx !== -1) { let start = dayIdx + 15; let end = txt.indexOf("';", start); if (end > start) dataDayStr = txt.substring(start, end); }
                });

                if (dataStr) {
                    try {
                        let parsed = JSON.parse(dataStr);
                        let extractedName = $('#techText').text().match(/([A-Z0-9\s]+)\(/);
                        if (extractedName && extractedName[1]) $('#stkName').text(extractedName[1].trim()); else $('#stkName').text(displayCode);
                        $('#stkCode').text(code || '--');
                        
                        if (parsed.KLine20 && parsed.KLine20.length > 0) {
                            let lastDay = parsed.KLine20[parsed.KLine20.length - 1], prevDay = parsed.KLine20[parsed.KLine20.length - 2];
                            $('#stkDate').text(lastDay[0]);
                            let price = lastDay[2], prevPrice = prevDay ? prevDay[2] : price, change = price - prevPrice, pct = (change / prevPrice) * 100;
                            $('#stkPrice').text(price.toFixed(3));
                            $('#stkChange').text((change > 0 ? "+" : "") + change.toFixed(3));
