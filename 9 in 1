    function performQuantAnalysis(klines) {
        if(!klines.length) return { bankerVal:0, bankerBull:false, macdBull:false, finalSignal:'Neutral'};
        const close = klines.map(k => k.close);
        const e12 = ema(close, 12); const e26 = ema(close, 26);
        const macd = e12.map((v, i) => v - e26[i]);
        const sigLine = ema(macd, 9);
        const hist = macd[macd.length-1] - sigLine[sigLine.length-1];
        let var0 = [];
        for (let i = 0; i < klines.length; i++) {
            const win = klines.slice(Math.max(0, i-59), i+1);
            let h60 = Math.max(...win.map(k => k.high)); let l60 = Math.min(...win.map(k => k.low));
            var0.push(h60 === l60 ? 50 : ((klines[i].close - l60) / (h60 - l60)) * 100);
        }
        const var1 = rma(rma(var0, 3), 4);
        const val = var1[var1.length-1] - 10;
        const prev = var1[var1.length-2] - 10;
        let score = 0;
        if (val > 50) score += 2; else if (val > prev) score += 1;
        if (hist > 0) score += 1;
        return { bankerVal: val.toFixed(1), bankerBull: val > prev, macdBull: hist > 0, finalSignal: score >= 1 ? 'Bullish' : 'Bearish' };
    }

