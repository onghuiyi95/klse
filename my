            10: "隱秘吸籌後的第一根放量長陽，信號明確，起步速度快。"
        };

        const _base = atob("aHR0cHM6Ly9oY20ucnpmd3EuY29tL2h3aGNuZXdBL2x6d19jaG9vc2VTdG9ja0RhdGFWMi5zaG9w");
        const _t1 = atob("ZjM4N2RiODk2MWNjYmJlZjRjODZlMDI0NmI2MDY2OWJiMDFlMDY0ODBlNDQ1ZmM2");
        const _t2 = atob("ZjM4N2RiODk2MWNjYmJlZjM4NTY3YWVlZjI2N2Y3MmEyY2Y0MDkxZjdjNzk2MTBj");
        function _getStratUrl(id, sp=false){ return `${_base}?jwcode=${sp?_t2:_t1}&id=${id}&from=1&version=1.0&city=my&language=cn`; }
        const STRATEGY_URLS = { 1:_getStratUrl(37), 2:_getStratUrl(38), 3:_getStratUrl(34), 4:_getStratUrl(35), 5:_getStratUrl(36), 6:_getStratUrl(33), 7:_getStratUrl(32), 8:_getStratUrl(31), 9:_getStratUrl(29, true), 10:_getStratUrl(30) };

        let currentStrategyIndex = 1;
        let currentData = [];
        let displayData = [];
        let tvChartObj = null, subChartObj = null, mainCandleSeries = null, trendRibbonSeries = null, m4LineSeries = null;
        let globalKlines = []; 
        let typeWriterTimeout = null;
        let sortCol = '', sortAsc = false;

        function rma(s, l) { if(!s || !s.length) return []; let a=1/l, r=[s[0]], m=s[0]; for(let i=1; i<s.length; i++) { m=a*s[i]+(1-a)*m; r.push(m); } return r; }
        function ema(s, l) { if(!s || !s.length) return []; let k=2/(l+1), r=[s[0]], m=s[0]; for(let i=1; i<s.length; i++) { m=(s[i]-m)*k+m; r.push(m); } return r; }

        // ==========================================
        // 核心同步邏輯 (經典模式)
        // ==========================================
        async function syncFromKLSEScreener() {
            const overlay = document.getElementById('loadingOverlay');
            overlay.classList.remove('hidden');
            try {
                const targetUrl = encodeURIComponent("https://www.klsescreener.com/v2/screener/quote_results");
                const response = await fetch(PROXY_URL + targetUrl);
                let htmlText = await response.text();
                try { const json = JSON.parse(htmlText); if(json.content) htmlText = json.content; } catch(e) {}

                const parser = new DOMParser();
                const doc = parser.parseFromString(htmlText, 'text/html');
                const rows = doc.querySelectorAll('tr');
                currentData = [];
                rows.forEach((row, index) => {
                    const cells = row.querySelectorAll('td');
                    if (cells.length < 5) return;
                    let code = "", name = "", codeIdx = -1;
                    for (let i = 0; i < Math.min(cells.length, 5); i++) {
                        let text = cells[i].innerText.trim();
                        if (/^\d{4}$/.test(text)) { code = text; codeIdx = i; name = cells[i-1] ? cells[i-1].innerText.trim().replace(/\s*\[[Ss]\]/g, '').trim() : "未知"; break; }
                    }
                    if (codeIdx !== -1) {
                        let priceText = cells[codeIdx + 2] ? cells[codeIdx + 2].innerText.trim() : "0";
                        let changeText = cells[codeIdx + 4] ? cells[codeIdx + 4].innerText.trim().replace('%', '') : "0";
                        const p = parseFloat(priceText.replace(/,/g, ''));
                        const c = parseFloat(changeText);
                        if (!isNaN(p) && code) {
                            currentData.push({ id: index, code, name, price: p.toFixed(2), change: isNaN(c) ? "0.00" : c.toFixed(2), signal: c > 1.2 ? 'Bullish' : (c < -1.2 ? 'Bearish' : 'Neutral') });
                        }
                    }
                });
                applyFilters();
            } catch (err) {
                console.error(err);
                document.getElementById('stockTableBody').innerHTML = `<tr><td colspan="4" class="py-20 text-center text-red-400">數據獲取異常。</td></tr>`;
            } finally { overlay.classList.add('hidden'); }
        }

        // ==========================================
        // 量化計算與 Gemini 動態分析
        // ==========================================
        function performQuantAnalysis(klines) {
            if(!klines.length) return { bankerVal:0, bankerBull:false, macdBull:false, finalSignal:'Neutral'};
            const close = klines.map(k => k.close);
            const e12 = ema(close, 12); const e26 = ema(close, 26);
            const macd = e12.map((v, i) => v - e26[i]);
            const sigLine = ema(macd, 9);
            const hist = macd[macd.length-1] - sigLine[sigLine.length-1];
            let var0 = [];
            for (let i = 0; i < klines.length; i++) {
                const win = klines.slice(Math.max(0, i-59), i+1);
                let h60 = Math.max(...win.map(k => k.high)); let l60 = Math.min(...win.map(k => k.low));
                var0.push(h60 === l60 ? 50 : ((klines[i].close - l60) / (h60 - l60)) * 100);
            }
            const var1 = rma(rma(var0, 3), 4);
            const val = var1[var1.length-1] - 10;
            const prev = var1[var1.length-2] - 10;
            let score = 0;
            if (val > 50) score += 2; else if (val > prev) score += 1;
            if (hist > 0) score += 1;
            return { bankerVal: val.toFixed(1), bankerBull: val > prev, macdBull: hist > 0, finalSignal: score >= 1 ? 'Bullish' : 'Bearish' };
        }

        async function generateDetailedAIText(q, stock) {
            const node = document.getElementById('aiContent');
            node.classList.remove('hidden'); 
            document.getElementById('aiLoading').classList.remove('hidden');
            node.innerHTML = '';

            const stage = currentStrategyIndex === 9 ? '吸籌階段' : '拉升階段';
            const prompt = `你是一位資深的馬股(Bursa Malaysia)量化分析師。請根據以下技術指標為股票 ${stock.name} (${stock.code}) 寫一份簡短且專業的個股分析報告。
            目前量化數據：
            - 當前階段: ${stage}
            - 主力控盤度 (Banker Value): ${q.bankerVal} (大於50表示高度控盤)
            - 資金動能趨勢: ${q.bankerBull ? '轉強' : '觀望/轉弱'}
            - MACD趨勢: ${q.macdBull ? '多頭' : '空頭'}
            - 系統綜合判定: ${q.finalSignal === 'Bullish' ? '看漲' : '盤整/看跌'}

            請使用 Tailwind HTML 格式排版輸出。可以包含 <p>, <ul>, <li>, <strong>, <span> 等標籤。
