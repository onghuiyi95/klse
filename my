    <script>
        const PROXY_URL = 'https://script.google.com/macros/s/AKfycbwNxtWwgZhGV7giqEViIsZzELNFyqviC42xDqw_zS4xqhG5UFHt-izvKvsQxubDIAwMpw/exec?url=';
        const apiKey = ""; 

        const STRATEGY_DESC = {
            1: "監控主力資金爆發性流入。主看 BBD 資金動能翻紅。",
            2: "結合 Banker Rhythm，鎖定即將起飛的個股。",
            3: "大數據篩選具備爆發基因的股票，適合追蹤強勢行情。",
            4: "捕捉主升浪瘋牛股，回踩支撐位即是買點。",
            5: "與莊家共舞，同步主力的操作節奏。",
            6: "強勢莊家高度鎖倉，籌碼穩定，適合中長線。",
            7: "識別莊家出貨與洗盤，尋找空中加油機會。",
