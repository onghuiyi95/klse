        function renderMainChart(data) {
            const mb = document.getElementById('tvChartContainer');
            mb.innerHTML = '';
            tvChartObj = LightweightCharts.createChart(mb, { 
                autoSize: true, 
                layout: { textColor: '#d1d4dc', background: { type: 'solid', color: '#131722' } },
                grid: { vertLines: { visible: false }, horzLines: { color: '#2b2b43' } },
                timeScale: { visible: false }
            });
            mainCandleSeries = tvChartObj.addCandlestickSeries({ upColor: '#26a69a', downColor: '#ef5350', borderVisible: false, wickUpColor: '#26a69a', wickDownColor: '#ef5350' });
            mainCandleSeries.setData(data);

            const showTrend = document.getElementById('mainChartSelect').value === 'trend';

            // 趨勢階梯 (Trend Ladder) 計算與繪圖
            let jj = data.map(k => (k.high + k.low + k.close) / 3);
            let a_ema = ema(jj, 13);
            let ribbonData = [];
            for (let i = 1; i < a_ema.length; i++) {
                let t = data[i].time;
                let A = a_ema[i];
                let B = a_ema[i-1];
                let isUp = A > B;
                let col = isUp ? 'rgba(38, 166, 154, 0.6)' : 'rgba(239, 83, 80, 0.6)'; 
                if(!isNaN(A) && !isNaN(B)) {
                    ribbonData.push({ time: t, open: B, close: A, high: Math.max(A, B), low: Math.min(A, B), color: col, borderColor: col, wickColor: col });
                }
            }
            trendRibbonSeries = tvChartObj.addCandlestickSeries({ borderVisible: false, lastValueVisible: false, priceLineVisible: false, visible: showTrend });
            trendRibbonSeries.setData(ribbonData);

            // M4 趨勢生命線
            let closes = data.map(k => k.close);
            let m2 = ema(closes, 8);
            let m4 = ema(m2, 55);
            let m4Data = [];
            for (let i = 0; i < m4.length; i++) {
                if(!isNaN(m4[i])) m4Data.push({ time: data[i].time, value: m4[i] });
            }
            m4LineSeries = tvChartObj.addLineSeries({ color: '#f5cb5c', lineWidth: 2, lastValueVisible: false, priceLineVisible: false, visible: showTrend });
            m4LineSeries.setData(m4Data);

            tvChartObj.timeScale().fitContent();
        }

        function toggleMainIndicator() {
            const show = document.getElementById('mainChartSelect').value === 'trend';
            if (trendRibbonSeries) trendRibbonSeries.applyOptions({ visible: show });
            if (m4LineSeries) m4LineSeries.applyOptions({ visible: show });
        }

        function drawIndicator(type) {
            const sub = document.getElementById('subChartContainer');
            sub.innerHTML = '';
            subChartObj = LightweightCharts.createChart(sub, { 
                autoSize: true, 
                layout: { textColor: '#d1d4dc', background: { type: 'solid', color: '#131722' } },
                grid: { vertLines: { visible: false }, horzLines: { color: '#2b2b43' } },
                timeScale: { borderColor: '#2b2b43', timeVisible: true }
            });
            
            tvChartObj.timeScale().subscribeVisibleTimeRangeChange(r => subChartObj.timeScale().setVisibleRange(r));

            const closes = globalKlines.map(k => k.close);
            const lows = globalKlines.map(k => k.low);
            const highs = globalKlines.map(k => k.high);
            const opens = globalKlines.map(k => k.open);
            let markers = [];

            if (type === 'bbd') {
                let al = [];
                for (let i = 0; i < globalKlines.length; i++) { al.push((globalKlines[i].close + globalKlines[i].low + globalKlines[i].high) / 3); }
                let rma_al_5 = rma(al, 5); let rma_al_21 = rma(al, 21);
                let ao = []; for (let i = 0; i < globalKlines.length; i++) { ao.push(rma_al_5[i] - rma_al_21[i]); }
                let rma_ao_3 = rma(ao, 3);
                
                let bbd = [];
                for (let i = 0; i < globalKlines.length; i++) { bbd.push((ao[i] - rma_ao_3[i]) * 100); }

                let bbdData = [];
                for (let i = 1; i < bbd.length; i++) {
                    let t = globalKlines[i].time, v = bbd[i], prev_v = bbd[i-1], prev2_v = i > 1 ? bbd[i-2] : prev_v;
                    let isUp = v >= prev_v, wasUp = prev_v >= prev2_v;
                    let col = isUp ? 'rgba(38, 166, 154, 0.9)' : 'rgba(239, 83, 80, 0.9)'; 

                    if(!isNaN(v) && !isNaN(prev_v)) {
                        bbdData.push({ time: t, open: prev_v, close: v, high: Math.max(prev_v, v), low: Math.min(prev_v, v), color: col, borderColor: col, wickColor: col });
                        if (i > 1) {
                            let isBuy = false, isSell = false;
                            if ((!wasUp && isUp) || (prev_v <= 0 && v > 0)) isBuy = true;
                            if ((wasUp && !isUp) || (prev_v >= 0 && v < 0)) isSell = true;
                            if (isBuy) markers.push({ time: t, position: 'belowBar', color: '#4caf50', shape: 'arrowUp', text: 'B' });
                            else if (isSell) markers.push({ time: t, position: 'aboveBar', color: '#e91e63', shape: 'arrowDown', text: 'S' });
                        }
                    }
                }
                const bbdSeries = subChartObj.addCandlestickSeries({ borderVisible: false }); 
                bbdSeries.setData(bbdData);
                bbdSeries.createPriceLine({ price: 0, color: '#f5cb5c', lineWidth: 1, lineStyle: 1 });
                
            } else if (type === 'banker') {
                let var0 = [], var4 = [];
                for (let i = 0; i < globalKlines.length; i++) {
                    const win = globalKlines.slice(Math.max(0, i - 59), i + 1);
                    let h60 = -Infinity, l60 = Infinity;
                    for(let k of win) { if(k.high > h60) h60 = k.high; if(k.low < l60) l60 = k.low; }
                    if(h60 === l60) { var0.push(50); var4.push(50); } else {
                        var0.push(((globalKlines[i].close - l60) / (h60 - l60)) * 100);
                        var4.push(((h60 - globalKlines[i].close) / (h60 - l60)) * 100);
                    }
                }
                const var1Raw = rma(rma(var0, 3), 4); const var2Raw = rma(rma(var4, 3), 4);
                
                let ribbon1Data = [], ribbon2Data = [];
                for (let i = 1; i < var1Raw.length; i++) {
                    let t = globalKlines[i].time, v1 = var1Raw[i] - 10, v2 = var2Raw[i] - 90;
                    let prev_v1 = var1Raw[i-1] - 10, prev_v2 = var2Raw[i-1] - 90, prev2_v1 = i > 1 ? var1Raw[i-2] - 10 : prev_v1;
                    
                    // 根據需求：Banker Rhythm (主力節奏) 紅青對調
                    let col = (v1 >= prev_v1) ? 'rgba(239, 83, 80, 0.9)' : 'rgba(38, 166, 154, 0.9)'; 

                    if(!isNaN(v1) && !isNaN(v2) && !isNaN(prev_v1) && !isNaN(prev_v2)) {
                        ribbon1Data.push({ time: t, open: prev_v1, close: v1, high: Math.max(prev_v1, v1), low: Math.min(prev_v1, v1), color: col, borderColor: col, wickColor: col });
                        ribbon2Data.push({ time: t, open: prev_v2, close: v2, high: Math.max(prev_v2, v2), low: Math.min(prev_v2, v2), color: col, borderColor: col, wickColor: col });
                        if (i > 1) {
                            if (prev_v1 <= 50 && v1 > 50) markers.push({ time: t, position: 'aboveBar', color: '#e91e63', shape: 'arrowDown', text: 'C' });
                            if (prev_v1 >= 50 && v1 < 50) markers.push({ time: t, position: 'aboveBar', color: '#ff9800', shape: 'arrowDown', text: 'S' });
                            let hasB = false;
                            if (prev_v1 <= 0 && v1 > 0) hasB = true;
                            if (prev_v1 <= prev2_v1 && v1 > prev_v1 && v1 < 10) hasB = true;
                            if (hasB) markers.push({ time: t, position: 'belowBar', color: '#4caf50', shape: 'arrowUp', text: 'B' });
                        }
                    }
                }
                const ribbon1 = subChartObj.addCandlestickSeries({ borderVisible: false }); ribbon1.setData(ribbon1Data);
                ribbon1.createPriceLine({ price: 50, color: 'rgba(255, 235, 59, 0.4)', lineWidth: 1, lineStyle: 2 });
                ribbon1.createPriceLine({ price: 0, color: '#888', lineWidth: 1, lineStyle: 1 });
                const ribbon2 = subChartObj.addCandlestickSeries({ borderVisible: false }); ribbon2.setData(ribbon2Data);
                ribbon2.createPriceLine({ price: -50, color: 'rgba(255, 235, 59, 0.4)', lineWidth: 1, lineStyle: 2 });

            } else if (type === 'accumulation') {
                let var1 = globalKlines.map((k, i) => (k.open + k.high + k.low + k.close) / 4);
                let m = globalKlines.map((k, i) => i === 0 ? 0 : Math.max(k.low - var1[i-1], 0));
                let abs_diff = globalKlines.map((k, i) => i === 0 ? 0 : Math.abs(k.low - var1[i-1]));
                let var2 = rma(abs_diff, 13).map((v, i) => v / (rma(m, 10)[i] || 1));
                let var3 = ema(var2, 10);
                let var5 = ema(globalKlines.map((k, i) => (k.low <= Math.min(...lows.slice(Math.max(0, i-32), i+1))) ? var3[i] : 0), 3);
                let diff = globalKlines.map((c, i) => i === 0 ? 0 : c.close - globalKlines[i-1].close);
                let rsi1 = rma(diff.map(v => Math.max(v, 0)), 12).map((v, i) => (v / (rma(diff.map(v => Math.abs(v)), 12)[i] || 1)) * 100);
                let accData = [];
                for (let i = 1; i < var5.length; i++) {
                    let col = rsi1[i] < 30 ? (var5[i] > (var5[i-1]||0) ? 'rgba(239, 83, 80, 0.9)' : 'rgba(38, 166, 154, 0.9)') : 'rgba(100, 100, 100, 0.2)';
                    accData.push({ time: globalKlines[i].time, value: var5[i], color: col });
                }
                subChartObj.addHistogramSeries({ base: 0 }).setData(accData);

            } else if (type === 'volume') {
                const volSeries = subChartObj.addHistogramSeries({ color: '#26a69a', priceFormat: { type: 'volume' } });
                const volData = globalKlines.map((k, i) => ({
                    time: k.time, value: k.volume,
                    color: (i > 0 && k.close < globalKlines[i-1].close) ? 'rgba(239, 83, 80, 0.8)' : 'rgba(38, 166, 154, 0.8)'
                }));
                volSeries.setData(volData);

            } else if (type === 'macd') {
                const ema12 = ema(closes, 12); const ema26 = ema(closes, 26);
                let macdLine = []; for(let i=0; i<closes.length; i++) { macdLine.push(ema12[i] - ema26[i]); }
                const signalLine = ema(macdLine, 9);
                let macdData = [], signalData = [], histData = [];
                for(let i=0; i<closes.length; i++) {
                    let t = globalKlines[i].time; let hist = macdLine[i] - signalLine[i];
                    macdData.push({ time: t, value: macdLine[i] }); signalData.push({ time: t, value: signalLine[i] });
                    histData.push({ time: t, value: hist, color: hist >= 0 ? 'rgba(38, 166, 154, 0.8)' : 'rgba(239, 83, 80, 0.8)' });
                }
                subChartObj.addHistogramSeries({ base: 0 }).setData(histData);
                subChartObj.addLineSeries({ color: '#2962FF', lineWidth: 2 }).setData(macdData);
                subChartObj.addLineSeries({ color: '#FF6D00', lineWidth: 2 }).setData(signalData);
            }

            if (mainCandleSeries) mainCandleSeries.setMarkers(markers);
            subChartObj.timeScale().fitContent();
        }

